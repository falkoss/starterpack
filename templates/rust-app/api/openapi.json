{
  "openapi": "3.1.0",
  "info": {
    "title": "{{name}}",
    "description": "The open API of {{name}}: {{tagline_lower}}.",
    "license": {
      "name": "{{licence}}",
      "identifier": "{{licence}}"
    },
    "version": "0.0.0"
  },
  "paths": {
    "/api/v1/items": {
      "get": {
        "tags": [],
        "summary": "Every item.",
        "operationId": "items",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ItemView"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [],
        "summary": "Adds an item.",
        "operationId": "add_item",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewItem"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ItemView"
                }
              }
            }
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/items/{id}": {
      "delete": {
        "tags": [],
        "summary": "Removes an item.",
        "operationId": "remove_item",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "the item",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ItemView"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ItemView": {
        "type": "object",
        "description": "An item as the API shows it.",
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "description": "Unique within the workspace.",
            "minimum": 0
          },
          "title": {
            "type": "string",
            "description": "What the item is called."
          }
        }
      },
      "NewItem": {
        "type": "object",
        "description": "A new item.",
        "required": [
          "title"
        ],
        "properties": {
          "title": {
            "type": "string",
            "description": "What it is called: not empty, at most 200 characters."
          }
        }
      },
      "Problem": {
        "type": "object",
        "description": "An error: what was refused or went wrong.",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string",
            "description": "What happened, in English."
          }
        }
      }
    }
  }
}
